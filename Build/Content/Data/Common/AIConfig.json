{
  // =========================================================================
  //  AI 参数配置（支持部分覆盖：只写想改的字段，其余自动沿用代码内置默认值）
  //  加载路径：Content/Data/Common/AIConfig.json（同样支持 Mod 覆盖）
  // =========================================================================

  // ------------------------- 城池命令优先级 -------------------------
  // 最终得分 = 基础分 + 态势动态分 + 个性修正 + 紧急覆盖，按得分降序执行
  "cityOrder": {
    // ---------------- 一、基础权重（每条命令的起始分） ----------------
    "baseAIAttack": 60,
    "baseAIReinforce": 40,
    "baseAITradeFood": 30,
    "baseAIIntrior": 50,
    "baseAISecurity": 30,
    "baseAITrainTroop": 25,
    "baseAIRewardPerson": 20,
    "baseAIRecruitTroop": 40,
    "baseAICreateItems": 40,
    "baseAICreateMachine": 20,
    "baseAICreateBoat": 20,
    "baseAISearching": 25,
    "baseAIRecruitPerson": 25,
    "baseAITransfrom": 30,
    "baseAITransfromToBelongCity": 35,
    "baseAIResearch": 25,
    "baseAIMakeSupplyTroop": 30,

    // ---------------- 二、态势阈值 ----------------
    "fillCritical": 0.2,
    "fillLow": 0.5,
    "fillHigh": 0.7,
    "fillFull": 0.9,
    "troopLowFill": 0.3,
    "troopMidFill": 0.6,
    "troopHighFill": 0.7,
    "weaponCoverRatio": 0.5,
    "rewardGoldThreshold": 1000,
    "researchGoldThreshold": 5000,
    "machineEnough": 60,
    "securityCritical": 30,
    "securityLow": 50,
    "securityOk": 70,
    "moraleLow": 40,
    "moraleOk": 60,
    "weaponCrisisTroops": 1000,
    "crisisFoodFill": 0.15,

    // ---------------- 三、评分分值 ----------------
    "scoreAttackBorderBonus": 40,
    "scoreAttackTroopHighBonus": 30,
    "scoreAttackTroopLowPenalty": 40,
    "scoreAttackNoPersonPenalty": 50,
    "scoreAttackSiegePenalty": 30,
    "scoreReinforcePerNeighbor": 50,
    "scoreReinforceTroopBonus": 20,
    "scoreReinforceSelfSiegePenalty": 100,
    "scoreFoodCriticalBonus": 80,
    "scoreFoodLowBonus": 40,
    "scoreFoodDefaultBonus": 15,
    "scoreInternalDefault": 10,
    "scoreInternalSiegePenalty": 60,
    "scoreInternalBorderPenalty": 20,
    "scoreInternalRichBonus": 20,
    "scoreSecurityCriticalBonus": 70,
    "scoreSecurityLowBonus": 40,
    "scoreMoraleLowBonus": 60,
    "scoreMoraleOkBonus": 35,
    "scoreMoraleDefaultBonus": 5,
    "scoreRewardBase": 10,
    "scoreRewardGoldBonus": 10,
    "scoreRecruitTroopCriticalBonus": 70,
    "scoreRecruitTroopLowBonus": 40,
    "scoreRecruitSecurityPenalty": 30,
    "scoreWeaponCriticalBonus": 50,
    "scoreWeaponLowBonus": 25,
    "scoreMachineEnoughPenalty": 30,
    "scoreMachineBonus": 40,
    "scoreBoatPortBonus": 15,
    "scoreBoatPenalty": 10,
    "scoreSearchingNoPersonPenalty": 50,
    "scoreSearchingBonus": 15,
    "scoreRecruitPersonNoPersonPenalty": 30,
    "scoreRecruitPersonBonus": 20,
    "scoreTransfromRichBonus": 40,
    "scoreTransfromDefaultBonus": 5,
    "scoreTransfromToBelongCityBonus": 30,
    "scoreResearchSiegePenalty": 60,
    "scoreResearchGoldBonus": 30,
    "scoreResearchDefaultBonus": 10,
    "scoreSupplyBonus": 60,
    "scoreSupplyPenalty": 50,

    // ---------------- 四、个性修正 ----------------
    "personalityAggressiveMilitaryBonus": 20,
    "personalityAggressiveInternalPenalty": 20,
    "personalityDefensiveMilitaryBonus": 15,
    "personalityDefensiveInternalBonus": 10,
    "personalityEconomicInternalBonus": 25,
    "personalityEconomicMilitaryPenalty": 25,
    "personalityDiplomaticPersonBonus": 20,

    // ---------------- 五、紧急覆盖 ----------------
    "siegeDefenseBias": 200,
    "siegeInternalPenalty": 80,
    "reinforceBias": 80,
    "threatBias": 100,
    "subCityBias": 60,
    "crisisFoodBias": 150,
    "crisisSecurityBias": 100,
    "crisisWeaponBias": 80,
    "peaceInternalBias": 30,
    "peaceMilitaryPenalty": 40
  },

  // ------------------------- 部队态势分档 -------------------------
  // 部队每回合按"局部敌我兵力占比"分档，档位决定进攻倾向 / 反击容忍 / 撤退概率 / 择优池
  "useTierStrategy": true,
  "useTierRetreat": true,
  "tierScanRange": 12,
  "tierDecisivePercent": 65,        // 我方占比 ≥ 此值 → 碾压
  "tierAdvantagedPercent": 45,      // ≥ 此值 → 优势
  "tierEvenPercent": 35,            // ≥ 此值 → 均势
  "tierDisadvantagedPercent": 25,   // ≥ 此值 → 劣势；低于 → 危局

  // 倍率均为百分数，100 = 不修正；bestN = 1 表示直接取最优行动，0 = 不择优
  "tierCritical":      { "attackScale":  50, "counterPenaltyScale": 200, "retreatChance": 80, "bestN": 1 },
  "tierDisadvantaged": { "attackScale":  80, "counterPenaltyScale": 150, "retreatChance": 40, "bestN": 1 },
  "tierEven":          { "attackScale": 100, "counterPenaltyScale": 100, "retreatChance": 10, "bestN": 5 },
  "tierAdvantaged":    { "attackScale": 120, "counterPenaltyScale":  80, "retreatChance":  0, "bestN": 3 },
  "tierDecisive":      { "attackScale": 140, "counterPenaltyScale":  50, "retreatChance":  0, "bestN": 1 },

  // ------------------------- 部队角色 -------------------------
  // 角色决定"怎么打"，与任务（去哪）正交
  "useTroopRole": true,
  "roleAssault":    { "attackScale": 120, "counterPenaltyScale":  60, "missionFocusScale": 130 },  // 攻坚
  "roleDefender":   { "attackScale":  90, "counterPenaltyScale": 150, "missionFocusScale": 110 },  // 防守
  "roleHarasser":   { "attackScale": 110, "counterPenaltyScale":  80, "missionFocusScale": 140 },  // 骚扰
  "roleSkirmisher": { "attackScale": 100, "counterPenaltyScale": 120, "missionFocusScale":  80 },  // 游击
  "roleEscort":     { "attackScale":  70, "counterPenaltyScale": 180, "missionFocusScale": 100 },  // 护卫
  "roleGuard":      { "attackScale":  80, "counterPenaltyScale": 150, "missionFocusScale":  70 },  // 守备

  // ------------------------- 部队技能评分公式 -------------------------
  // 原为代码内硬编码字面量，外置后可直接调参
  "scoreSkillBaseFactor": 150,
  "scoreRangeBonus": 15,
  "scoreSingleBonus": 5,
  "scoreEffectBonus": 5,
  "scoreControlBonus": 30,
  "scoreStrategySuccessThreshold": 75,
  "scoreStrategySuccessBonus": 2,
  "scoreAttackDefenceBase": 200,
  "scoreMinCostEnergy": 10,
  "scoreBuildingDamageFactor": 4,
  "scoreBuildingSingleFactor": 15,
  "scoreBuildingMultiFactor": 10,
  "scoreBuildingRangeFactor": 150,
  "scoreBuildingMeleeFactor": 100,
  "scoreFriendlyBuildingFactor": -8,
  "scoreFinalDivisor": 100,

  // ------------------------- 任务权重（倍率 %） -------------------------
  // 替代原先 500000 / 5 / 1000000 / 30000 / 50000 等魔法数字
  "taskPrimaryTargetWeight": 5000,
  "taskOtherTargetWeight": 5,
  "taskStayBonus": 200,
  "taskMeleeCloseBonus": 50,
  "taskBuildingWeight": 100,
  "taskBigTroopBonus": 30,
  "taskBigTroopPercent": 150,
  "protectCityThreatRange": 5,
  "protectCityNearEnemyBonusPerCell": 40,

  // ------------------------- 人才部署（武将调度：岗位编制 / 调动节奏） -------------------------
  // 只写要覆盖的字段即可，其余沿用代码内置默认值（DeploymentWeights）。
  // 注意：shadowLogIntervalTurns 现在**只控制日志输出频率**，不再影响调人节奏（每回合都会执行）。
  "deployment": {
    "enabled": true,
    "shadowOnly": false,                // true = 只计算不调人（调试用）
    "shadowLogEnabled": true,           // 是否输出部署报告（仅编辑器 / 开发包）
    "shadowLogForceId": -1,             // -1 = 报告所有势力；0 = 只报告玩家；>0 = 指定势力 id
    "shadowLogIntervalTurns": 3,        // 每 N 个势力回合输出一次报告（只影响日志）
    "shadowLogCorpsId": 0,              // >0 = 只报告该军团（军团级调度才有意义）

    // ---- 军团边界与人才开关（**只约束玩家势力**，AI 势力以势力为边界） ----
    // 玩家侧：
    //   · 军团边界：源城与目标城必须同军团，跨团一律否决；
    //   · "人才"开关（军团委任界面可改，代码里是 Corps.AppointContentType.Person：
    //     0 = 允许 AI 代管，1 = 玩家自己管）：只有开启的军团才跑调度，未开启整块跳过；
    //   · 第一军团（君主所在军团）由玩家直辖，只出"仅参考"影子报告、不调人。
    // AI 势力侧：目标城与抽调池都是全势力，势力内可跨军团调人，上述三条都不适用。
    "enforceCorpsBoundary": true,       // 玩家军团边界开关（对 AI 势力无效）

    // ---- 编制基准（本次未改动，仅显式化便于调参） ----
    "troopExpectFill": 0.8,
    "troopsPerUnit": 5000,
    "deputyPerUnit": 0.5,
    "troopSeatOnlyWhenThreatened": true, // 军事岗只在"前线(圈层0) / 次前线(圈层1) / 威胁达标城"按预想兵力折算
    "rearMilitarySeat": 0,               // 纯后方(圈层≥2)且威胁未达标的城：军事岗数（0 = 不设，只留运输/战略储备岗）

    // ---- 调动节奏与门槛 ----
    "debounceTurns": 2,                 // 同一武将 N 个势力回合内不再被调走
    "maxTransferPerCityPerTurn": 2,     // 每城每回合接收基准额度
    "frontlineExtraReceiveSeat": 2,     // 前线 / 高威胁城额外接收额度
    "maxTransferFromCityPerTurn": 1,    // 每城每回合调出基准额度
    "overloadedFreePersonThreshold": 30,// 空闲 ≥ 此值视为"人力超载城"
    "overloadedSendLimit": 5,           // 超载城的调出额度
    "maxTransferPerTurn": 12,           // 势力级每回合调动总人数上限
    "minTransferScore": 0.1,            // 外调最低匹配分（硬性岗不受限）
    "stealLocalCost": 0.4,              // 抢占"本城在岗"人选的额外成本（优先用真正的机动人力）
    "militaryMinAbility": 80,           // 军事/守备岗能力下限：统率+武力 < 此值不派去带兵（硬性岗不受限）
    "minPortGateGuard": 1               // 港关至少保留的守备人数
  }
}
