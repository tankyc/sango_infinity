  "taskPrimaryTargetWeight": 5000,
  "taskOtherTargetWeight": 5,
  "taskStayBonus": 200,
  "taskMeleeCloseBonus": 50,
  "taskBuildingWeight": 100,
  "taskBigTroopBonus": 30,
  "taskBigTroopPercent": 150,
  "protectCityThreatRange": 5,
  "protectCityNearEnemyBonusPerCell": 40
}
