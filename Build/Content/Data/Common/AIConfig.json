{
  // =========================================================================
  //  AI 参数配置（本文件已**全量覆盖** AIConfig 的全部字段）
  //  加载路径：Content/Data/Common/AIConfig.json（同样支持 Mod 覆盖）
  //
  //  【改默认值必看】AIConfig.cs 里的字段默认值只在该键**不在本文件**时才生效。
  //  现在所有字段都写在这里，改 AIConfig.cs 的默认值不会影响本文件已写出的值 ——
  //  要改行为必须同步改本文件（或删掉对应行让它回落到代码默认值）。
  // =========================================================================

  // ------------------------- 外交 -------------------------
  // AI 开始外交的回合数（原版 force_diplomacy 的 get_turn() < 9 不外交）
  "diplomacyStartTurn": 12,
  // AI 开始执行"劝降/吞并"的回合数（原版 force_annex 的 turn < 36）
  "diplomacyAnnexStartTurn": 48,
  // 结盟 / 送礼 / 请求援军 的每回合触发概率（%，原版 rand_bool(30)）
  "diplomacyActionChance": 18,
  // 破弃同盟的触发概率（%，原版 force_discard 的 rand_bool(30)）
  "diplomacyDiscardChance": 20,
  // 送礼的错峰周期：turn % N == force.Id % N 才轮到（原版 %5）
  "diplomacyDonateStagger": 8,
  // 战时求和的错峰周期（原版 turn % 21，只对"打进来的那家"求和）
  "diplomacyCeasefireWarStagger": 24,
  // 预防性停战的外层错峰周期（原版 `s11_game_ai_force_cmd_dip.cpp:596` 的 `turn % 21 == force_id % 21`，仅在"没有在进攻任何人"时生效）。
  "diplomacyCeasefirePeaceStagger": 9,
  // 被 ≥3 家相邻敌势力围住时，预防性停战再加一道错峰（原版 `:632` 的 `turn % 6`）。
  "diplomacyCeasefireManyEnemyStagger": 6,

  // ------------------------- 城市防守 -------------------------
  // 判定"兵临城下"的距离（格）。此范围内存在存活敌人时，城市优先出城防守
  "cityDefenseAlertRange": 8,
  // 实时扫描城池周边以兜底检测敌人的范围（格）。用于预计算敌人信息未覆盖的场景（如敌军刚抵达、正在攻击本城建筑）
  "cityDefenseScanRange": 6,
  // 判定"是否需要召回前线部队回援本城"的扫描范围（格）。 与 cityDefenseAlertRange / cityDefenseScanRange 区分：
  "cityRecallScanRange": 4,

  // ------------------------- 城市支援 -------------------------
  // 派兵支援所需的本城最低兵力
  "reinforceMinTroops": 10000,
  // 派兵支援所需的本城最低粮草
  "reinforceMinFood": 8000,
  // 派兵支援所需的本城最低空闲武将数
  "reinforceMinFreePersons": 2,
  // 单个城市最多同时派出的支援部队数量
  "reinforceMaxTroopPerCity": 2,

  // ------------------------- 城市出兵 -------------------------
  // 【已停用】进攻他城的基础出兵上限（支部队）。 原版没有"支数"这个概念：kyoten_attack 用"在外累计兵力 > 所需兵力"决定停不停
  "attackBaseTroopCount": 12,
  // 【已停用】目标城池每多少兵力追加 1 支出兵，见 attackBaseTroopCount
  "attackTroopsPerTargetTroops": 3000,
  // 【已停用】进攻无主白城的出兵上限，见 attackBaseTroopCount
  "attackWhiteCityTroopCount": 2,
  // 好战个性每回合跳过进攻的概率（%）。越低越积极出兵（原硬编码 50）
  "attackSkipChanceAggressive": 18,
  // 均衡个性每回合跳过进攻的概率（%）。越低越积极出兵（原硬编码 70）
  "attackSkipChanceBalanced": 25,
  // 谨慎个性每回合跳过进攻的概率（%）。越低越积极出兵（原硬编码 80）
  "attackSkipChanceDefensive": 35,
  // 好战个性出兵所需的最低城内兵力（原硬编码 8000，见 CityAI.AICanAttack）。 与外置的跳过概率配合调整，单改一项容易被另一项卡住。
  "attackMinTroopsAggressive": 6000,
  // 均衡个性出兵所需的最低城内兵力（原硬编码 10000）
  "attackMinTroopsBalanced": 7000,
  // 谨慎个性出兵所需的最低城内兵力（原硬编码 12000）
  "attackMinTroopsDefensive": 9000,
  // 进入"目标打分"所需的最低城内兵力（原硬编码 20000，见 CityAI.DecideAttackTarget）。 【为什么必须一起调】AICanAttack 只决定"这回合出不出兵"，
  "attackTargetMinTroops": 12000,
  // 进攻目标打分时，若目标势力是玩家势力，额外增加的权重（默认 1500）。 【语义】加法项，叠加在"兵力比 × 城池耐久 × 外交关系 × 距离"之后，不是百分比：
  "attackTargetPlayerBonus": 1500,
  // AI 单次出阵（Attack 命令）消耗的据点行动力，默认 5。 【为什么需要单独配】实际扣减在 CityAI.AIAttack，
  "aiAttackActionPointCost": 5,
  "logAttackAI": false,

  // ------------------------- 城市内政 -------------------------
  "buildMinGold": 500,
  // 治安 / 训练等内政作业所需的城池最低金钱
  "internalMinGold": 400,
  // 造兵装所需的最低金钱
  "createItemsMinGold": 1000,
  // 造船 / 造器械所需的最低金钱
  "createMachineMinGold": 1500,
  // 买粮所需保留的最低金钱（低于此值不买粮）
  "tradeFoodKeepGold": 2000,
  // 褒奖武将所需保留的最低金钱
  "rewardGoldKeep": 500,
  // 褒奖武将的忠诚上限（低于该值才褒奖）
  "rewardLoyaltyThreshold": 90,
  // 褒奖武将的单回合人数上限（避免一击耗尽金钱）
  "rewardMaxPersonPerTurn": 1,
  // 升级建筑允许的最大工期（回合），超过则暂缓升级
  "buildUpgradeMaxTurn": 6,
  // 搜索行动的基础概率（%）
  "searchBaseChance": 60,
  // 每名未发现武将额外增加的搜索概率（%），体现"未发现越多越勤于搜索"
  "searchInvisibleChancePerPerson": 15,
  // 招募在野武将的单回合人数上限
  "recruitPersonMaxPerTurn": 1,
  // 士气低于该值时必定训练
  "cityMoraleLow": 70,
  // 训练概率的基准士气值（与当前士气之差线性折算概率）
  "trainMoraleBase": 100,

  // ------------------------- 补给部队 -------------------------
  // 组建补给队所需的城池最低兵力
  "supplyMinCityTroops": 20000,
  // 组建补给队所需的城池最低粮草
  "supplyMinCityFood": 60000,
  // 单个城市同时派出的补给队上限（战场级，通常一支即可覆盖整条战线）
  "supplyMaxPerCity": 1,
  // 配比门槛：附近至少这么多支待补给友军时，才值得派出一支补给队（避免一对一）
  "supplyMinNeedyTroops": 3,
  // 每支补给队携带的兵力上限（需能支撑一个战场）
  "supplyTroopAmount": 30000,
  // 补给队粮草可支撑的回合数（按携带兵力 × 每兵粮耗估算携带量）
  "supplyFoodTurnCount": 30,
  // 每支补给队携带粮草的硬上限
  "supplyFoodAmount": 400000,
  // 友军粮草低于「兵力 × 该系数」时视为需要补给
  "supplyFoodThresholdFactor": 3,
  // 补给队搜索待补给友军的最大距离（格）
  "supplySearchRange": 20,
  // 补给队威胁扫描范围（格）。该范围内没有敌人则视为安全，可直接贴近友军
  "supplyThreatScanRange": 6,
  // 前线部队的兵装覆盖率低于该百分比时视为"兵装不足"，值得派出补给队（%）
  "supplyNeedyItemPercent": 50,
  // 补给队出征的最低随队兵力；可装备兵力（兵装数）低于该值时取消出征
  "supplyMinCarryTroops": 3000,

  // ------------------------- 威胁部队驱逐 -------------------------
  // 驱逐威胁部队的距离（格）。敌方部队进入本城该范围且位于本势力领地内时，派兵歼灭
  "driveOutThreatRange": 25,
  // 单城同时派出的驱逐部队「基准」支数（实际上限 = 基准 + 敌群兵力/每支追加兵力，再按下面的硬顶封顶）
  "driveOutMaxTroopPerCity": 3,
  // 驱逐部队支数的动态硬上限（防止一回合把城池抽空）
  "driveOutMaxTroopPerCityCap": 12,
  // 敌群兵力每多出这么多，追加 1 支驱逐部队（0 或负数 = 不追加，退化为固定支数）
  "driveOutTroopsPerExtraTroop": 6000,
  // 统计「敌群兵力」的聚集半径（格）；0 = 只算威胁目标本身
  "driveOutThreatClusterRange": 3,
  // 出兵前的兵力比门槛（%）：我方可用兵力/敌群兵力 低于该值则暂缓出兵；0 或负数 = 关闭评估（恢复旧行为）
  "driveOutMinForceRatio": 70,
  // 是否启用「驱逐求援」：打不动的城把威胁登记到势力层，由兵力充裕的邻城接单
  "useDriveOutAid": true,
  // 响应驱逐求援的最大距离（格）
  "driveOutAidRange": 20,
  // 响应求援所需的兵力比门槛（%），比自城驱逐的 driveOutMinForceRatio 更严；取 120 会出现「强城明明能打却拒接」，建议 100~110
  "driveOutAidMinForceRatio": 100,

  // ------------------------- 部队 AI 模式 -------------------------
  // 【严格对齐原版】是否用 Open311 的 unit_update_order 直译 （，对应 s11_game_ai_unit.cpp:99-315）
  "useStrictOpen311UnitAI": true,

  // ------------------------- 部队撤退（保存实力） -------------------------
  // 兵力低于该值时有概率撤退（就近入驻己方据点补给）
  "retreatMinTroops": 300,
  // 兵力低于满编该百分比时，同样视为"兵力过低"并就近入驻补给（0 表示仅使用绝对阈值 retreatMinTroops）
  "retreatTroopPercent": 25,
  // 士气低于该值时有概率撤退
  "retreatMinMorale": 10,
  // 断粮时的撤退概率（%）
  "retreatOutOfFoodChance": 80,
  // 兵力过低时的撤退概率（%）
  "retreatFewTroopsChance": 60,
  // 士气过低时的撤退概率（%）
  "retreatLowMoraleChance": 50,
  // 出征回合数门槛：部队在野外待满该回合数之后，才允许做出撤退 / 回避决定。 用于抑制"刚出城就掉头回城"：刚出城的部队常被判定为劣势 / 危局（态势看的是局部战力比），
  "retreatMinLiveDays": 3,

  // ------------------------- 部队态势分档 -------------------------
  // 是否启用战场态势分级策略（关闭则所有部队按"均势"档处理）
  "useTierStrategy": true,
  // 态势评估的搜索范围（格）。反映所考虑的"局部战场"大小
  "tierScanRange": 12,
  // 我方兵力占比 ≥ 该值时判定为"碾压"（%）
  "tierDecisivePercent": 65,
  // 我方兵力占比 ≥ 该值时判定为"优势"（%）
  "tierAdvantagedPercent": 45,
  // 我方兵力占比 ≥ 该值时判定为"均势"（%）
  "tierEvenPercent": 35,
  // 我方兵力占比 ≥ 该值时判定为"劣势"，低于该值则判定为"危局"（%）
  "tierDisadvantagedPercent": 25,
  // 危局档权重：保存实力、脱离接触
  "tierCritical": {
    "attackScale": 50,
    "counterPenaltyScale": 200,
    "retreatChance": 80,
    "bestN": 1
  },
  // 劣势档权重：收缩防守
  "tierDisadvantaged": {
    "attackScale": 80,
    "counterPenaltyScale": 150,
    "retreatChance": 40,
    "bestN": 1
  },
  // 均势档权重：谨慎试探
  "tierEven": {
    "attackScale": 100,
    "counterPenaltyScale": 100,
    "retreatChance": 10,
    "bestN": 5
  },
  // 优势档权重：主动进攻
  "tierAdvantaged": {
    "attackScale": 120,
    "counterPenaltyScale": 80,
    "retreatChance": 0,
    "bestN": 3
  },
  // 碾压档权重：强攻追击
  "tierDecisive": {
    "attackScale": 140,
    "counterPenaltyScale": 50,
    "retreatChance": 0,
    "bestN": 1
  },
  // 是否允许部队因"态势不利"主动撤退（关闭则仅保留原有的断粮 / 兵少 / 士气撤退）
  "useTierRetreat": true,

  // ------------------------- 部队领队性格（框架参数） -------------------------
  // 是否启用领队性格对部队策略的影响（性格数值定义在 Personality 数据中）
  "useLeaderPersonality": true,
  // 是否允许性格覆盖任务推导出的部队角色
  "useLeaderRoleOverride": true,
  // 是否允许性格影响计略技能的释放偏好
  "useLeaderSkillPreference": true,
  // 性格层倍率的下限（%）
  "leaderScaleMin": 50,
  // 性格层倍率的上限（%）
  "leaderScaleMax": 150,
  // 合成后攻击倍率的下限（%），防止 tier × role × 性格 三层连乘失控
  "finalAttackScaleMin": 40,
  // 合成后攻击倍率的上限（%）
  "finalAttackScaleMax": 180,
  // 合成后反击倍率的下限（%）
  "finalCounterScaleMin": 40,
  // 合成后反击倍率的上限（%）
  "finalCounterScaleMax": 180,
  // 性格好战指数（|troopAggression|）达到该值时，性格角色覆盖任务角色
  "leaderRoleOverrideThreshold": 20,
  // 行动择优池的全局上限（防止性格修正后池过大）
  "bestNMax": 8,
  // 行动择优池的全局下限
  "bestNMin": 1,
  // 计略专精每点折算的收益倍率（%）
  "leaderSkillTendencyScalePerPoint": 5,
  // 计略偏好倍率的下限（%）
  "leaderSkillScaleMin": 75,
  // 计略偏好倍率的上限（%）
  "leaderSkillScaleMax": 150,
  // 危局档的撤退不受性格影响（防止"莽将送死"）
  "leaderIgnoreRetreatInCritical": true,

  // ------------------------- 部队角色 -------------------------
  // 是否启用部队角色分级（关闭则所有部队按"通用"处理，不做角色修正）
  "useTroopRole": true,
  // 攻坚：敢吃反击、强打目标
  "roleAssault": {
    "attackScale": 120,
    "counterPenaltyScale": 60,
    "missionFocusScale": 130
  },
  // 防守：重视规避反击与地形
  "roleDefender": {
    "attackScale": 90,
    "counterPenaltyScale": 150,
    "missionFocusScale": 110
  },
  // 骚扰：专注任务、打完就跑
  "roleHarasser": {
    "attackScale": 110,
    "counterPenaltyScale": 80,
    "missionFocusScale": 140
  },
  // 游击：任务专注度低，容易被眼前目标吸引
  "roleSkirmisher": {
    "attackScale": 100,
    "counterPenaltyScale": 120,
    "missionFocusScale": 80
  },
  // 护卫：尽量避免接战
  "roleEscort": {
    "attackScale": 70,
    "counterPenaltyScale": 180,
    "missionFocusScale": 100
  },
  // 守备：驻守据点，不主动出击
  "roleGuard": {
    "attackScale": 80,
    "counterPenaltyScale": 150,
    "missionFocusScale": 70
  },
  // 工兵：携带资金修建前线辅助建筑，极度规避接战
  "roleEngineer": {
    "attackScale": 40,
    "counterPenaltyScale": 250,
    "missionFocusScale": 150
  },

  // ------------------------- 部队技能评分 -------------------------
  // 被反击惩罚系数（越大越规避"贴脸打高反击单位"）
  "counterAttackPenaltyFactor": 10,
  // 被反击惩罚对攻击收益的最大削弱比例（%），防止 AI 过度保守而完全不行动
  "counterAttackPenaltyFloorPercent": 50,
  // 技能基础收益的总系数
  "scoreSkillBaseFactor": 150,
  // 远程技能加成
  "scoreRangeBonus": 15,
  // 单体技能加成
  "scoreSingleBonus": 5,
  // 带额外效果技能加成
  "scoreEffectBonus": 5,
  // 目标处于被控制状态（混乱 / 眩晕）时的加成
  "scoreControlBonus": 30,
  // 策略技能成功率的最低门槛，低于该值直接放弃施放
  "scoreStrategySuccessThreshold": 75,
  // 策略技能成功率超出门槛时，每点折算的施法距离加成
  "scoreStrategySuccessBonus": 2,
  // 是否启用"剑兵倾向计略"。关闭则剑兵与其它兵种一视同仁
  "useSwordStrategyPreference": true,
  // 剑兵的计略收益倍率（%）。>100 表示比其它兵种更愿意释放计略；设为 100 等于关闭倾向
  "swordStrategyScoreScale": 200,
  // 剑兵的计略成功率门槛（%）。低于全局门槛，让智力平平的剑兵队也敢赌计略
  "swordStrategySuccessThreshold": 50,
  // 攻防差值的基数（避免攻防差为负时整体收益归零）
  "scoreAttackDefenceBase": 200,
  // 技能能耗的最小值（防止除零并限制低耗技能的过高收益）
  "scoreMinCostEnergy": 10,
  // 攻打建筑时的伤害倍数
  "scoreBuildingDamageFactor": 4,
  // 攻打建筑：单体技能的收益倍数
  "scoreBuildingSingleFactor": 15,
  // 攻打建筑：多体技能的收益倍数
  "scoreBuildingMultiFactor": 10,
  // 攻打建筑：远程技能的施法距离系数
  "scoreBuildingRangeFactor": 150,
  // 攻打建筑：近战技能的施法距离系数
  "scoreBuildingMeleeFactor": 100,
  // 误伤友方建筑的收益倍数（负数表示惩罚）
  "scoreFriendlyBuildingFactor": -8,
  // 最终分数的缩放除数（把内部大数压到可比较的量级）
  "scoreFinalDivisor": 100,
  // 【严格对齐原版】是否用"真实伤害预演"决定这一击值不值得打。 对应原版 get_attack_damage_score（D:\open311\s11\s11_sys_unit_action.cpp:1780-1834）：
  "useRealDamageScore": true,
  // 【严格对齐原版】攻击目标时，若目标周围 1~2 格内有**本方建筑**，额外加的分值。 对应原版 get_target_score（D:\open311\s11\s11_sys_unit_action.cpp:1742-1754）：
  "scoreNearFriendlyBuildingBonus": 4950,
  // 是否启用 **Open311 原版评分体系**（离散加项制）替代本项目的连续分制。 true（默认）= 完全按原版 get_target_score / get_attack_damage_score /
  "useOpen311ScoreFormula": true,
  // 敌方目标加分 —— 原版 get_target_score:1694-1695
  "o311TargetHostile": 5000,
  // 友方目标加分 —— 原版 get_target_score:1696-1697
  "o311TargetFriendly": 1500,
  // 误伤己方目标的扣分（以正值配置，代码里取负）。 【为什么需要这一项】canDamageTeam = true 的技能（妖术、落雷这类真 AOE）在执行层是
