  // ------------------------- 部队态势分档 -------------------------
  // 部队每回合按"局部敌我兵力占比"分档，档位决定进攻倾向 / 反击容忍 / 撤退概率 / 择优池
  "useTierStrategy": true,
  "useTierRetreat": true,
  "tierScanRange": 12,
  "tierDecisivePercent": 65,        // 我方占比 ≥ 此值 → 碾压
  "tierAdvantagedPercent": 45,      // ≥ 此值 → 优势
  "tierEvenPercent": 35,            // ≥ 此值 → 均势
  "tierDisadvantagedPercent": 25,   // ≥ 此值 → 劣势；低于 → 危局

  // 倍率均为百分数，100 = 不修正；bestN = 1 表示直接取最优行动，0 = 不择优
  "tierCritical":      { "attackScale":  50, "counterPenaltyScale": 200, "retreatChance": 80, "bestN": 1 },
  "tierDisadvantaged": { "attackScale":  80, "counterPenaltyScale": 150, "retreatChance": 40, "bestN": 1 },
  "tierEven":          { "attackScale": 100, "counterPenaltyScale": 100, "retreatChance": 10, "bestN": 5 },
  "tierAdvantaged":    { "attackScale": 120, "counterPenaltyScale":  80, "retreatChance":  0, "bestN": 3 },
  "tierDecisive":      { "attackScale": 140, "counterPenaltyScale":  50, "retreatChance":  0, "bestN": 1 },

  // ------------------------- 部队角色 -------------------------
  // 角色决定"怎么打"，与任务（去哪）正交
  "useTroopRole": true,
  "roleAssault":    { "attackScale": 120, "counterPenaltyScale":  60, "missionFocusScale": 130 },  // 攻坚
  "roleDefender":   { "attackScale":  90, "counterPenaltyScale": 150, "missionFocusScale": 110 },  // 防守
  "roleHarasser":   { "attackScale": 110, "counterPenaltyScale":  80, "missionFocusScale": 140 },  // 骚扰
  "roleSkirmisher": { "attackScale": 100, "counterPenaltyScale": 120, "missionFocusScale":  80 },  // 游击
  "roleEscort":     { "attackScale":  70, "counterPenaltyScale": 180, "missionFocusScale": 100 },  // 护卫
  "roleGuard":      { "attackScale":  80, "counterPenaltyScale": 150, "missionFocusScale":  70 },  // 守备

  // ------------------------- 部队技能评分公式 -------------------------
  // 原为代码内硬编码字面量，外置后可直接调参
  "scoreSkillBaseFactor": 150,
  "scoreRangeBonus": 15,
  "scoreSingleBonus": 5,
  "scoreEffectBonus": 5,
  "scoreControlBonus": 30,
  "scoreStrategySuccessThreshold": 75,
  "scoreStrategySuccessBonus": 2,
  "scoreAttackDefenceBase": 200,
  "scoreMinCostEnergy": 10,
  "scoreBuildingDamageFactor": 4,
  "scoreBuildingSingleFactor": 15,
  "scoreBuildingMultiFactor": 10,
  "scoreBuildingRangeFactor": 150,
  "scoreBuildingMeleeFactor": 100,
  "scoreFriendlyBuildingFactor": -8,
  "scoreFinalDivisor": 100,

  // ------------------------- 任务权重（倍率 %） -------------------------
