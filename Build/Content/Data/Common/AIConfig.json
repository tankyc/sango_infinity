    "baseAIReinforce": 40,
    "baseAITradeFood": 30,
    "baseAIIntrior": 50,
    "baseAISecurity": 30,
    "baseAITrainTroop": 25,
    "baseAIRewardPerson": 20,
    "baseAIRecruitTroop": 40,
    "baseAICreateItems": 40,
    "baseAICreateMachine": 20,
    "baseAICreateBoat": 20,
    "baseAISearching": 25,
    "baseAIRecruitPerson": 25,
    "baseAITransfrom": 30,
    "baseAITransfromToBelongCity": 35,
    "baseAIResearch": 25,
    "baseAIMakeSupplyTroop": 30,

    // ---------------- 二、态势阈值 ----------------
    "fillCritical": 0.2,
    "fillLow": 0.5,
    "fillHigh": 0.7,
    "fillFull": 0.9,
    "troopLowFill": 0.3,
    "troopMidFill": 0.6,
    "troopHighFill": 0.7,
    "weaponCoverRatio": 0.5,
    "rewardGoldThreshold": 1000,
