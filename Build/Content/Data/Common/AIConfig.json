    "scoreBoatPortBonus": 15,
    "scoreBoatPenalty": 10,
    "scoreSearchingNoPersonPenalty": 50,
    "scoreSearchingBonus": 15,
    "scoreRecruitPersonNoPersonPenalty": 30,
    "scoreRecruitPersonBonus": 20,
    "scoreTransfromRichBonus": 40,
    "scoreTransfromDefaultBonus": 5,
    "scoreTransfromToBelongCityBonus": 30,
    "scoreResearchSiegePenalty": 60,
    "scoreResearchGoldBonus": 30,
    "scoreResearchDefaultBonus": 10,
    "scoreSupplyBonus": 60,
