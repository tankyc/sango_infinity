# =============================================================
# Sango ModHub 服务端配置（复制自 .env.example，按实际情况修改）
# =============================================================

# 服务监听
PORT=8081
HOST=0.0.0.0

# 对外访问基址：写进 /market/mod_list.txt 的 url 字段，客户端据此拼下载地址
# 客户端按 MakeUrl 规则：截掉结尾的 "/mod_list.txt"，再拼 "/{id}@{version}.zip"
APP_BASE_URL=http://localhost:8081

# JWT 密钥（生产务必更换）
JWT_SECRET=sango-modhub-dev-secret-please-change
JWT_EXPIRES_IN=30d

# SQLite 数据库（相对 prisma/schema.prisma 所在目录解析）
DATABASE_URL=file:../../data/modhub.db

# 运行期数据根目录（相对 server/ 目录解析）
DATA_DIR=../data

# 上传限制
UPLOAD_MAX_ZIP_MB=200
UPLOAD_MAX_POSTER_MB=5

# 发布后是否直接上架（false 则需管理员审核后才出现在市场清单里）
AUTO_APPROVE=true

# -------------------------------------------------------------
# 超级管理员
# 服务启动时自动创建（或把同名账号提升为 admin），幂等，无需连数据库操作
# 生产环境务必修改默认密码；忘记密码时把 FORCE_PASSWORD 置 true 重启一次即可重置
# -------------------------------------------------------------
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=sango@admin
SUPER_ADMIN_FORCE_PASSWORD=false

# 市场清单名称（客户端模组管理器里显示的市场名）
MARKET_NAME=Sango Workshop

# 市场清单缓存秒数
MARKET_CACHE_TTL=300

# 下载计数去重窗口（秒），同一 IP + 模组版本在该窗口内只计一次
DOWNLOAD_DEDUPE_WINDOW=3600

# -------------------------------------------------------------
# 分发与存储（详见 建设计划.md §6.1）
# 冷启动：全部走 local，CDN_BASE_URL 留空 → 服务器直接吐文件
# 有量后：STORAGE_DRIVER=s3 + CDN_BASE_URL=https://cdn.xx → 统一 302 跳 CDN
# 客户端已验证会自动跟随 302，无需改动游戏
# -------------------------------------------------------------
STORAGE_DRIVER=local
CDN_BASE_URL=

# STORAGE_DRIVER=s3 时生效（兼容 COS/OSS/R2 等 S3 协议对象存储）
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
